.DS_Store
**/.DS_Store

# fish generated state (usually not worth tracking)
fish/.config/fish/fish_variables
fish/.config/fish/fish_history
fish/.config/fish/conf.d/

# host-specific secrets/IPs, not tracked (see env.fish.example)
fish/.config/fish/env.fish
fedora/fish/.config/fish/env.fish

# host-specific IPs/hostnames/UUIDs, not tracked (see runbook-example.md)
server/runbook.md

# historical/forensic notes split out of runbook.md, not tracked
server/server-history.md

# micro generated state (fedora only; macOS micro package was removed)
fedora/micro/.config/micro/buffers/
fedora/micro/.config/micro/backups/
fedora/micro/.config/micro/history/

# homebrew lock files
homebrew/.homebrew/trust.json.lock

# editor swap/backup files
*~
*.swp
*.swo
