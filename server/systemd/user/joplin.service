[Unit]
Description=Joplin Sync Server (Podman, rootless)
After=network-online.target mnt-storage.mount
RequiresMountsFor=/mnt/storage

[Service]
Type=exec
ExecStartPre=/usr/bin/bash -c 'for i in $(seq 1 30); do mountpoint -q /mnt/storage && exit 0; sleep 1; done; echo "mnt-storage not mounted after 30s" >&2; exit 1'
ExecStart=/usr/bin/podman run --name joplin \
  --replace \
  -p 100.106.45.25:22300:22300 \
  -p 127.0.0.1:22300:22300 \
  -e APP_PORT=22300 \
  -e APP_BASE_URL=https://centos.tail586311.ts.net:8444 \
  -e SQLITE_DATABASE=/database/db.sqlite \
  -v /mnt/storage/Joplin:/database:Z \
  --pull=never \
  docker.io/joplin/server:latest
ExecStop=/usr/bin/podman stop -t 10 joplin
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
