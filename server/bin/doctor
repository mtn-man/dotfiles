#!/usr/bin/env bash
set -euo pipefail

if [[ "$EUID" -eq 0 ]]; then
    echo "doctor must be run as eli, not root" >&2
    exit 1
fi


warnings=0
criticals=0

row() {
    printf '%-20s %s\n' "${1}:" "$2"
}

# Storage mount
if mountpoint -q /mnt/storage 2>/dev/null; then
    row "storage" "ok"
else
    row "storage" "CRITICAL: not mounted"
    criticals=$(( criticals + 1 ))
fi

# Jellyfin service
if systemctl is-active --quiet jellyfin.service 2>/dev/null; then
    row "jellyfin" "ok"
else
    row "jellyfin" "CRITICAL: not active"
    criticals=$(( criticals + 1 ))
fi

# Jellyfin update check — read-only; never pulls or restarts
local_version=$(curl -s --max-time 5 http://localhost:8096/System/Info/Public 2>/dev/null | grep -oE '"Version":"[^"]+"' | cut -d'"' -f4)
latest_version=$(curl -s --max-time 5 https://api.github.com/repos/jellyfin/jellyfin/releases/latest 2>/dev/null | grep -oE '"tag_name": *"v[0-9.]+"' | grep -oE '[0-9][0-9.]*')
if [[ -z "$local_version" || -z "$latest_version" ]]; then
    row "jellyfin update" "warn: check failed"
    warnings=$(( warnings + 1 ))
elif [[ "$local_version" == "$latest_version" ]]; then
    row "jellyfin update" "ok (${local_version})"
else
    row "jellyfin update" "warn: ${local_version} -> ${latest_version} available"
    warnings=$(( warnings + 1 ))
fi

# VPN tunnel
vpn_status=$(sudo podman exec nordvpn nordvpn status 2>/dev/null || true)
if printf '%s' "$vpn_status" | grep -q "Status: Connected"; then
    row "vpn tunnel" "connected"
else
    row "vpn tunnel" "CRITICAL: not connected"
    criticals=$(( criticals + 1 ))
fi

# NordVPN client update check — read-only; never installs
local_version=$(sudo podman exec nordvpn nordvpn version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')
latest_version=$(curl -s --max-time 5 "https://repo.nordvpn.com/deb/nordvpn/debian/pool/main/n/nordvpn/" 2>/dev/null | grep -oE 'nordvpn_[0-9]+\.[0-9]+\.[0-9]+_amd64\.deb' | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | sort -V | tail -1)
if [[ -z "$local_version" || -z "$latest_version" ]]; then
    row "nordvpn update" "warn: check failed"
    warnings=$(( warnings + 1 ))
elif [[ "$local_version" == "$latest_version" ]]; then
    row "nordvpn update" "ok (${local_version})"
else
    row "nordvpn update" "warn: ${local_version} -> ${latest_version} available"
    warnings=$(( warnings + 1 ))
fi

# Transmission service
if systemctl is-active --quiet transmission.service 2>/dev/null; then
    row "transmission" "ok"
else
    row "transmission" "CRITICAL: not active"
    criticals=$(( criticals + 1 ))
fi

# Transmission update check — read-only; never pulls or restarts
local_version=$(sudo podman exec transmission transmission-daemon --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
latest_version=$(curl -s --max-time 5 https://api.github.com/repos/transmission/transmission/releases/latest 2>/dev/null | grep -oE '"tag_name": *"[0-9.]+"' | grep -oE '[0-9][0-9.]*')
if [[ -z "$local_version" || -z "$latest_version" ]]; then
    row "transmission update" "warn: check failed"
    warnings=$(( warnings + 1 ))
elif [[ "$local_version" == "$latest_version" ]]; then
    row "transmission update" "ok (${local_version})"
else
    row "transmission update" "warn: ${local_version} -> ${latest_version} available"
    warnings=$(( warnings + 1 ))
fi

# Joplin Server update check — read-only; never pulls or restarts
local_version=$(podman inspect joplin --format '{{ index .Config.Labels "org.opencontainers.image.version" }}' 2>/dev/null)
latest_version=$(curl -s --max-time 5 "https://hub.docker.com/v2/repositories/joplin/server/tags?page_size=25&ordering=last_updated" 2>/dev/null | grep -oE '"name":"[0-9]+\.[0-9]+\.[0-9]+"' | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')
if [[ -z "$local_version" || -z "$latest_version" ]]; then
    row "joplin update" "warn: check failed"
    warnings=$(( warnings + 1 ))
elif [[ "$local_version" == "$latest_version" ]]; then
    row "joplin update" "ok (${local_version})"
else
    row "joplin update" "warn: ${local_version} -> ${latest_version} available"
    warnings=$(( warnings + 1 ))
fi

# mintmedia service — must run as eli; --user bus is session-specific
if systemctl --user is-active --quiet mintmedia.service 2>/dev/null; then
    row "mintmedia" "ok"
else
    row "mintmedia" "CRITICAL: not active"
    criticals=$(( criticals + 1 ))
fi

# Drive temperature — resolve media drive by UUID to avoid relying on sda/sdb enumeration order
storage_part=$(sudo blkid -U d477f156-a70d-4aba-ab3d-5fa6d194e982 2>/dev/null || true)
storage_dev="${storage_part%[0-9]}"
temp_line=$(sudo smartctl -d sat -l scttemp "$storage_dev" 2>/dev/null | grep "Current Temperature" || true)
if [[ -n "$temp_line" ]]; then
    temp=$(echo "$temp_line" | awk '{print $(NF-1)}')
    if [[ "$temp" =~ ^[0-9]+$ ]]; then
        if [[ "$temp" -ge 60 ]]; then
            row "drive temp" "CRITICAL: ${temp}C"
            criticals=$(( criticals + 1 ))
        elif [[ "$temp" -ge 51 ]]; then
            row "drive temp" "warn: ${temp}C"
            warnings=$(( warnings + 1 ))
        else
            row "drive temp" "ok (${temp}C)"
        fi
    else
        row "drive temp" "ok (standby)"
    fi
else
    row "drive temp" "ok (standby)"
fi

# Drive health — SMART overall-health self-assessment + reallocated/pending sector counts (informational)
health_output=$(sudo smartctl -H -A -d sat "$storage_dev" 2>/dev/null || true)
health_line=$(printf '%s' "$health_output" | grep -i "overall-health self-assessment")
realloc=$(printf '%s' "$health_output" | awk '$1 == 5 {print $NF}')
pending=$(printf '%s' "$health_output" | awk '$1 == 197 {print $NF}')
if printf '%s' "$health_line" | grep -q "PASSED"; then
    row "drive health" "ok (PASSED, reallocated=${realloc:-?}, pending=${pending:-?})"
elif printf '%s' "$health_line" | grep -q "FAILED"; then
    row "drive health" "CRITICAL: SMART self-assessment FAILED (reallocated=${realloc:-?}, pending=${pending:-?})"
    criticals=$(( criticals + 1 ))
else
    row "drive health" "warn: check failed"
    warnings=$(( warnings + 1 ))
fi

# Recent reboot
boot_epoch=$(date -d "$(uptime -s)" +%s)
now_epoch=$(date +%s)
age_hours=$(( (now_epoch - boot_epoch) / 3600 ))
if [[ "$age_hours" -lt 24 ]]; then
    row "recent reboot" "warn: rebooted ${age_hours}h ago"
    warnings=$(( warnings + 1 ))
else
    row "recent reboot" "ok"
fi

# Tailscale
ts_ip=$(tailscale ip -4 2>/dev/null || true)
if [[ -n "$ts_ip" ]]; then
    row "tailscale" "up ($ts_ip)"
else
    row "tailscale" "warn: down"
    warnings=$(( warnings + 1 ))
fi

# Tailscale Funnel — expected steady state is on, for Jellyfin only (see runbook Section 5)
funnel_output=$(tailscale serve status 2>/dev/null || true)
funnel_count=$(printf '%s' "$funnel_output" | grep -cF '(Funnel on)' || true)
if [[ "$funnel_count" -eq 0 ]]; then
    row "funnel" "warn: expected on for Jellyfin, found off"
    warnings=$(( warnings + 1 ))
elif [[ "$funnel_count" -gt 1 ]]; then
    row "funnel" "warn: on for multiple services"
    warnings=$(( warnings + 1 ))
else
    proxy_target=$(printf '%s' "$funnel_output" | grep -A1 -F '(Funnel on)' | grep '^|--' | awk '{print $NF}')
    case "$proxy_target" in
        *:8096) row "funnel" "on (Jellyfin)" ;;
        *)
            row "funnel" "warn: on for unexpected target ${proxy_target}"
            warnings=$(( warnings + 1 ))
            ;;
    esac
fi

# Summary
echo
if [[ "$criticals" -gt 0 && "$warnings" -gt 0 ]]; then
    printf '%-20s %d critical(s), %d warning(s)\n' "summary:" "$criticals" "$warnings"
elif [[ "$criticals" -gt 0 ]]; then
    printf '%-20s %d critical(s)\n' "summary:" "$criticals"
elif [[ "$warnings" -gt 0 ]]; then
    printf '%-20s %d warning(s)\n' "summary:" "$warnings"
else
    printf '%-20s ok\n' "summary:"
fi

if [[ "$criticals" -gt 0 ]]; then
    exit 2
elif [[ "$warnings" -gt 0 ]]; then
    exit 1
fi
